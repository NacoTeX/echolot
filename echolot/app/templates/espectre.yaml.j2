{#
  Per-device ESPHome configuration for an ESPectre presence sensor.
  Rendered by app/builder.py from a validated DeviceCreate payload.

  Modelled on ESPectre's own example configurations rather than assembled
  from prose docs — see
  https://github.com/francescopace/espectre/tree/main/examples
#}
esphome:
  name: {{ device_name }}
  friendly_name: {{ friendly_name | tojson }}

esp32:
{% if board.esphome_board %}
  board: {{ board.esphome_board }}
{% endif %}
{% if board.variant %}
  variant: {{ board.variant }}
{% endif %}
{% if board.cpu_frequency %}
  cpu_frequency: {{ board.cpu_frequency }}
{% endif %}
  framework:
    type: esp-idf
{% if direct_api %}
    sdkconfig_options:
      # ESPHome sizes CONFIG_LWIP_MAX_SOCKETS from the components that call
      # consume_sockets() during validation, and logs the itemised budget
      # ("TCP=11 [api=3, captive_portal=3, web_server=5] ..."). ESPectre is
      # an external component and does not take part in that count, so its
      # direct HTTP/SSE server on port 62587 asks the same shared LWIP pool
      # for up to seven more sockets than ESPHome budgeted:
      # direct_http_service_esp_idf.cpp sets max_open_sockets to
      # max_event_clients + 5, with max_event_clients capped at 2.
      #
      # It is one pool for TCP, UDP and listeners alike, so the overcommit
      # surfaces as socket exhaustion under load — and the first thing to
      # fail is the SSE stream the Calibration Lab and the live dashboard
      # depend on, which looks like a recording that simply stops.
      #
      # 24 = ESPHome's own worst case observed so far (17, with web_server
      # and captive_portal on) plus ESPectre's 7. A user-provided value
      # takes precedence over ESPHome's calculation; if ESPHome ever needs
      # more than this it says so at build time with the exact number.
      CONFIG_LWIP_MAX_SOCKETS: "24"
{% endif %}

wifi:
  ssid: {{ wifi_ssid | tojson }}
  password: {{ wifi_password | tojson }}
{% if wifi_bssid %}
  bssid: {{ wifi_bssid | tojson }}
{% endif %}
  # Reachable for reconfiguration if the credentials above stop working.
  ap:
    # The portal behind this AP takes Wi-Fi credentials, and it comes up
    # exactly when something is already wrong — a router swap, a changed
    # passphrase. An open AP is therefore at its most open at the least
    # convenient moment. The password is per device and shown in the
    # add-on next to the other credentials.
    ssid: {{ (device_name ~ " Fallback") | tojson }}
    password: {{ fallback_password | tojson }}

captive_portal:

api:
{% if api_encryption %}
  # The key is generated per device and stored by the add-on, which shows
  # it for pasting into Home Assistant. Without it anyone on the network
  # could read the sensor and drive the device.
  #
  # Off by default, and not because encryption is optional in principle:
  # `encryption:` makes ESPHome pull in noise-c/libsodium, and libsodium's
  # C sources include a bare "utils.h". ESPectre registers its own
  # src/cpp/core as a *public* ESP-IDF include directory and there is a
  # C++ utils.h in it, so the C compiler picks that one up and dies on
  # `#include <cstdint>`. The build cannot finish while both are present.
  # Turn this on once ESPectre stops publishing that directory.
  encryption:
    key: {{ api_encryption_key | tojson }}
{% endif %}

# Password-protected so the same is true of firmware updates.
ota:
  - platform: esphome
    password: {{ ota_password | tojson }}

logger:
  level: {{ log_level }}

# Lets Wi-Fi credentials be re-provisioned over USB without a rebuild.
improv_serial:
{% if web_server %}

# A page on the device itself, reachable at http://<ip>/ from any browser
# — including ones with no Web Serial, such as everything on iPadOS. It is
# the only way to answer "is this thing alive?" without a USB cable.
# `local: true` embeds the assets instead of pulling them from a CDN, so
# the page also works with the device cut off from the internet.
web_server:
  version: 3
  local: true
{% endif %}
{% if diagnostics %}

sensor:
  # Signal strength is not housekeeping here: CSI sensing degrades with a
  # weak link, so this is the number that tells you whether a spot is a
  # viable place for the device at all.
  - platform: wifi_signal
    name: "WiFi Signal"
    update_interval: 60s
    entity_category: diagnostic
  - platform: uptime
    name: "Uptime"
    entity_category: diagnostic
  # Supported on every ESP32 variant we offer, the original included
  # (it reads an undocumented register there, and reports nothing rather
  # than nonsense when that fails).
  - platform: internal_temperature
    name: "Internal Temperature"
    entity_category: diagnostic

text_sensor:
  # The IP address in particular: without it, a device that Home Assistant
  # has not discovered leaves you guessing at the router's device list.
  - platform: wifi_info
    ip_address:
      name: "IP Address"
      entity_category: diagnostic
    ssid:
      name: "Connected SSID"
      entity_category: diagnostic
    mac_address:
      name: "MAC Address"
      entity_category: diagnostic

button:
  - platform: restart
    name: "Restart"
    entity_category: config
  # Boots without the ESPectre component, so a device made unreachable by
  # a bad configuration can still take an OTA update.
  - platform: safe_mode
    name: "Restart (Safe Mode)"
    entity_category: config
{% endif %}

# ESPectre moved its ESPHome component deep into the repository when the
# project was restructured; `github://user/repo@ref` shorthand can only
# find a component folder at the root, so the long form with an explicit
# `path` is now the only one that resolves.
external_components:
  - source:
      type: git
      url: https://github.com/francescopace/espectre
      # A commit, not a branch. With `main` the same Echolot release
      # builds a different firmware next week, and "it worked yesterday"
      # stops being a usable sentence. Moved deliberately, in a release.
      ref: {{ espectre_ref }}
      path: src/cpp/frontend/esphome/components
    components: [espectre]

espectre:
  id: espectre_csi
  # lightweight: two-feature weighted model with startup calibration.
  # high_accuracy: eight-feature neural model, no calibration needed.
  detection_algorithm: {{ detection_algorithm }}
  # Packets per second of CSI the device aims to sample. `internal` means
  # it generates that traffic itself; `external` expects another source.
  csi_target_pps: {{ csi_target_pps }}
  csi_traffic_mode: {{ csi_traffic_mode }}
  traffic_generator_mode: {{ traffic_generator_mode }}
  # How often the detector runs. Shorter reacts sooner and costs more CPU.
  evaluation_interval_ms: {{ evaluation_interval_ms }}
  # The device's own HTTP/SSE surface on port 62587, which is what the
  # add-on's reachability check looks for besides the ESPHome API.
  direct_api: {{ "true" if direct_api else "false" }}
  # Every entity below has a sensible default name upstream; they are not
  # repeated here so a rename upstream reaches us instead of being
  # silently overridden.
