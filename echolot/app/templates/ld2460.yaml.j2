{#
  Per-device ESPHome configuration for an HLK-LD2460 radar node.
  Rendered by app/builder.py from a validated DeviceCreate payload.

  Credentials — API key, OTA password, fallback AP password — are the
  device's own and survive every rebuild, including the first radar build
  of a device converted from Wi-Fi CSI.
#}
esphome:
  name: {{ device_name }}
  friendly_name: {{ friendly_name | tojson }}
{% if antenna_select_pin is not none %}
  on_boot:
    # Before Wi-Fi comes up (priority 250), so the first association
    # already happens on the right antenna.
    priority: 800
    then:
      - output.turn_off: antenna_select
{% endif %}

esp32:
{% if board.esphome_board %}
  board: {{ board.esphome_board }}
{% endif %}
{% if board.variant %}
  variant: {{ board.variant }}
{% endif %}
{% if board.cpu_frequency %}
  cpu_frequency: {{ board.cpu_frequency }}
{% endif %}
  framework:
    type: esp-idf

wifi:
  ssid: {{ wifi_ssid | tojson }}
  password: {{ wifi_password | tojson }}
{% if wifi_bssid %}
  bssid: {{ wifi_bssid | tojson }}
{% endif %}
{% if board.dual_band %}
  # Radar does not measure on the Wi-Fi band — this only decides which
  # radio carries the data. Rendered because ESPHome's own default for
  # the C5 is AUTO, and a device should do what its configuration says.
  band_mode: {{ wifi_band | upper }}
{% endif %}
  ap:
    # The portal behind this AP takes Wi-Fi credentials and comes up
    # exactly when something is already wrong, so it is never open.
    ssid: {{ fallback_ssid | tojson }}
    password: {{ fallback_password | tojson }}

captive_portal:

api:
  # Always encrypted: positions of people in a room are not something to
  # send in the clear. Home Assistant and Echolot's own live link both
  # connect with this key.
  encryption:
    key: {{ api_encryption_key | tojson }}

ota:
  - platform: esphome
    password: {{ ota_password | tojson }}

logger:
  level: {{ log_level }}

improv_serial:
{% if web_server %}

web_server:
  version: 3
  local: true
{% endif %}
{% if antenna_select_pin is not none %}

output:
  # Held low: on the Waveshare ESP32-C5-Zero this selects the on-board
  # antenna instead of the U.FL socket. Taken from the board's wiring
  # and from the wohnzimmer-radar prototype, which ran on it that way.
  - platform: gpio
    id: antenna_select
    pin: GPIO{{ antenna_select_pin }}
{% endif %}

uart:
  id: radar_uart
  # ESP TX goes to the module's Rx2 (pin 8), ESP RX to its Tx2 (pin 7).
  # UART2 of the module is the one that carries targets and commands;
  # its UART1 does neither.
  tx_pin: GPIO{{ radar_tx_pin }}
  rx_pin: GPIO{{ radar_rx_pin }}
  baud_rate: 115200
  data_bits: 8
  parity: NONE
  stop_bits: 1
  # A few reports' worth. The component drains it every loop.
  rx_buffer_size: 512

external_components:
  - source:
      type: local
      path: {{ components_path | tojson }}
    components: [echolot_ld2460]

echolot_ld2460:
  id: radar
  uart_id: radar_uart
  # Whether an answering module with nothing to report is an empty room.
  # Unknown until a module has been watched in an empty room — see
  # ld2460_protocol.h. Off means such a room reads as "unknown", which is
  # the honest answer while the question is open.
  quiet_means_empty: {{ "true" if quiet_means_empty else "false" }}
  frame:
    # For Echolot's live link (app/radar_link.py), which finds it by this
    # name. Disabled in Home Assistant from the start so the recorder
    # does not store every report.
    name: "Radar Frame"
    disabled_by_default: true
  target_count:
    name: "Targets"
  status:
    name: "Radar Status"
  radar_firmware:
    name: "Radar Firmware"
{% if diagnostics %}
  rx_bytes:
    name: "Radar Bytes Received"
  report_frames:
    name: "Radar Reports"
  empty_frames:
    name: "Radar Empty Reports"
  rejected_frames:
    name: "Radar Rejected Frames"

sensor:
  - platform: wifi_signal
    name: "WiFi Signal"
    update_interval: 60s
    entity_category: diagnostic
  - platform: uptime
    name: "Uptime"
    entity_category: diagnostic
  - platform: internal_temperature
    name: "Internal Temperature"
    entity_category: diagnostic

text_sensor:
  - platform: wifi_info
    ip_address:
      name: "IP Address"
      entity_category: diagnostic
    ssid:
      name: "Connected SSID"
      entity_category: diagnostic
    mac_address:
      name: "MAC Address"
      entity_category: diagnostic

button:
  - platform: restart
    name: "Restart"
    entity_category: config
  - platform: safe_mode
    name: "Restart (Safe Mode)"
    entity_category: config
{% endif %}
